{
  "name": "city_0_newyork_3p5_noise_aug_32x64",
  "description": "New York 3.5 GHz CNN/ViT experiment with random complex AWGN training augmentation.",
  "output_root": "outputs/experiments/city_0_newyork_3p5_noise_aug_32x64",
  "dataset": {
    "generator": "deepmimo_v4",
    "scenario_root": "deepmimo_scenarios",
    "raw_path": "data/raw/city_0_newyork_3p5_max_32x64.mat",
    "processed_path": "data/processed/city_0_newyork_3p5_max_32x64.npz",
    "deepmimo": {
      "scenario": "city_0_newyork_3p5",
      "tx_set": 3,
      "tx_index": 0,
      "rx_set": 0,
      "antenna_shape": [32, 1],
      "antenna_spacing": 0.5,
      "bandwidth_hz": 20000000,
      "num_ofdm": 128,
      "ofdm_sampling_factor": 1,
      "ofdm_limit": 64,
      "num_paths": 25
    }
  },
  "preprocessing": {
