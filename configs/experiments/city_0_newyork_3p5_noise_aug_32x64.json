    "minimum_lr_ratio": 0.05,
    "amp": true,
    "device": "cuda",
    "threads": 4,
    "vit_patch_size": [4, 8],
    "noise_augmentation": {
      "enabled": true,
      "minimum_snr_db": 0.0,
      "maximum_snr_db": 30.0,
      "clean_probability": 0.2
    }
  },
  "robustness": {
    "snr_db": [30, 20, 10, 5, 0],
    "noise_seed": 2026,
    "batch_size": 128
  }
}
